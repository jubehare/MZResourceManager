<UserControl x:Class="MZResourceManager.Views.ResourceSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="#D1D1D1"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        Padding="14,12"
                        BorderBrush="#D1D1D1"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding CategoryTitle}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource AppColorSide2Brush}"/>
                </Border>

                <Border Grid.Row="1"
                        Background="White"
                        Padding="8,6"
                        BorderBrush="#D1D1D1"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#999999"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <Grid Grid.Column="1">
                                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" FontSize="12"
                                         BorderBrush="#D1D1D1" BorderThickness="1"/>
                                <TextBlock Text="Search…"
                                           IsHitTestVisible="False"
                                           Foreground="#AAAAAA" FontSize="12"
                                           Padding="8,5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SubFolderOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Command="{Binding DataContext.SelectSubFolderCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,4,4"
                                            Padding="8,3"
                                            FontSize="10"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#D1D1D1"/>
                                                <Setter Property="Foreground" Value="#1A1A1A"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="10"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#0078D4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding FilteredEntries}"
                         SelectedItem="{Binding SelectedEntry}"
                         Background="White"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Name row + optional ENGINE badge -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <Border CornerRadius="2"
                                            Padding="4,1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="#6B7280"
                                            ToolTip="Always loaded by the RPG Maker MZ engine — cannot be unused">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReserved}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="ENGINE"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <!-- Sub-folder label -->
                                <TextBlock Text="{Binding SubFolder}"
                                           FontSize="10"
                                           Foreground="#767676">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SubFolder}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#D1D1D1"
                    BorderThickness="0,0,0,1"
                    MinHeight="110">
                <Grid Margin="18,14">

                    <TextBlock Text="Select a file to preview"
                               Foreground="#999999"
                               FontSize="13"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding ShowNoSelection, Converter={StaticResource BoolToVis}}"/>

                    <Grid Visibility="{Binding ShowImagePreview, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <TextBlock Text="{Binding SelectedEntry.Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1A1A1A"
                                       VerticalAlignment="Center"/>
                            <Button Command="{Binding OpenFileCommand}"
                                    Width="26" Height="26"
                                    Margin="6,0,0,0"
                                    Cursor="Hand"
                                    ToolTip="Open file location">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="#EBEBEB"
                                                CornerRadius="4">
                                            <TextBlock Text="&#xE838;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="#555555"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#D6D6D6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <Image Grid.Row="1"
                               Source="{Binding PreviewImageSource}"
                               MaxHeight="180"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Grid>

                    <Grid Visibility="{Binding ShowAudioPreview, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedEntry.Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#1A1A1A"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource AppColorMain2Brush}"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AudioTypeLabel}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal">
                            <Button x:Name="PlayBtn"
                                    Padding="10,4"
                                    Content="▶  Play"
                                    Click="PlayButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="StopBtn"
                                    Padding="10,4"
                                    Content="■  Stop"
                                    Click="StopButton_Click"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="18,7">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="#767676"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Searching..."
                           FontSize="11"
                           Foreground="{StaticResource AppColorMain2Brush}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <TabControl Grid.Row="2">
                <TabControl.Resources>
                    <Style TargetType="TabPanel">
                        <Setter Property="Background"
                                Value="#F3F3F3"/>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Map Events">
                    <DataGrid ItemsSource="{Binding MapResults}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Map"
                                                Binding="{Binding MapDisplay}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Event"
                                                Binding="{Binding EventDisplay}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Page"
                                                Binding="{Binding PageDisplay}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Detail"
                                                Binding="{Binding Detail}"
                                                Width="350"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Common Events">
                    <DataGrid ItemsSource="{Binding CommonResults}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding EventId, StringFormat=D3}"
                                                Width="60"/>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding EventName}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Detail"
                                                Binding="{Binding Detail}"
                                                Width="350"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Battle Events">
                    <DataGrid ItemsSource="{Binding TroopResults}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Troop"
                                                Binding="{Binding TroopDisplay}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Page"
                                                Binding="{Binding PageDisplay}"
                                                Width="60"/>
                            <DataGridTextColumn Header="Detail"
                                                Binding="{Binding Detail}"
                                                Width="350"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Plugin Commands">
                    <DataGrid ItemsSource="{Binding PluginCmdResults}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plugin"
                                                Binding="{Binding PluginName}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Command"
                                                Binding="{Binding CommandName}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Parameter"
                                                Binding="{Binding ParamKey}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding ParamValue}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Context"
                                                Binding="{Binding Context}"
                                                Width="350"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</UserControl>
